{
    "name": "omnipay/firstdata",
    "type": "library",
    "description": "First Data driver for the Omnipay payment processing library",
    "keywords": [
        "first data",
        "firstdata",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment"
    ],
    "homepage": "https://github.com/thephpleague/omnipay-firstdata",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrian Macneil",
            "email": "adrian@adrianmacneil.com"
        },
        {
            "name": "Omnipay Contributors",
            "homepage": "https://github.com/thephpleague/omnipay-firstdata/contributors"
        }
    ],
    "autoload": {
        "psr-4": { "Omnipay\\FirstData\\" : "src/" }
    },
    "require": {
        "php": "^7.3|^8",
        "omnipay/common": "~3.1"
    },
    "require-dev": {
        "omnipay/tests": "^4"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
